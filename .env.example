# --- required ---
# Local dev Postgres from docker-compose.yml. For Supabase use the transaction pooler string (port 6543).
DATABASE_URL=postgresql://assetify:assetify@localhost:5434/assetify
# URL-encode special characters in the password (e.g. @ becomes %40). Leave pgbouncer params off.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- environment ---
ENV=dev
LOG_LEVEL=INFO
LOG_DIR=
APP_TIMEZONE=Asia/Kolkata
SESSION_HTTPS_ONLY=false

# --- Vercel Cron ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /internal/cron/warranty.
CRON_SECRET=

# In-house logins: Name|email|password, comma separated. Apply with: python -m app.cli seed-users
SEED_USERS=Sai|sai@gloify.com|1234,Girish|girish@gloify.com|1234
