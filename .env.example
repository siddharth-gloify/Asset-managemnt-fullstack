# --- required ---
# Local dev Postgres from docker-compose.yml. For Supabase use the transaction pooler string (port 6543).
DATABASE_URL=postgresql://assetify:assetify@localhost:5434/assetify
# URL-encode special characters in the password (e.g. @ becomes %40). Leave pgbouncer params off.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- environment ---
ENV=dev
LOG_LEVEL=INFO
LOG_DIR=
APP_TIMEZONE=Asia/Kolkata
SESSION_HTTPS_ONLY=false

# --- network allowlist ---
# Comma-separated CIDRs, e.g. 203.0.113.10/32,10.0.0.0/8. Empty = allow all in dev, refuse to start in prod.
ALLOWED_IPS=
# On Vercel set this to x-vercel-forwarded-for (Vercel overwrites it, so it cannot be spoofed).
CLIENT_IP_HEADER=
# Self-hosted behind nginx: CIDRs whose X-Forwarded-For is trusted (only used when CLIENT_IP_HEADER is empty).
TRUSTED_PROXIES=

# --- Vercel Cron ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /internal/cron/warranty.
CRON_SECRET=



